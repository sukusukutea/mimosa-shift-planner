<% if @holiday_conflict_dates.present? && @selected_staff.present? %>
  <div class="alert alert-warning py-2 px-2 small">
    <div class="fw-bold mb-1">登録の確認</div>
    <div class="mb-2">
      選択した日付のうち、勤務指定と重複する日があります。どちらを優先しますか？
    </div>

    <div class="mb-2 small text-muted">
      衝突日:
      <%= @holiday_conflict_dates.map { |d| d.strftime("%-m/%-d") }.join("、") %>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <%= form_with url: bulk_add_staff_holidays_shift_month_path(@shift_month),
                    method: :post,
                    local: true,
                    class: "m-0" do %>
        <%= hidden_field_tag :staff_id, @selected_staff.id %>
        <%= hidden_field_tag :holiday_type, @selected_holiday_type %>
        <% @selected_holiday_dates.each do |d| %>
          <%= hidden_field_tag "dates[]", d.iso8601 %>
        <% end %>
        <%= hidden_field_tag :force_mode, "override_conflicts" %>
        <%= button_tag "休日希望を優先する", class: "btn btn-sm btn-warning" %>
      <% end %>

      <%= form_with url: bulk_add_staff_holidays_shift_month_path(@shift_month),
                    method: :post,
                    local: true,
                    class: "m-0" do %>
        <%= hidden_field_tag :staff_id, @selected_staff.id %>
        <%= hidden_field_tag :holiday_type, @selected_holiday_type %>
        <% @selected_holiday_dates.each do |d| %>
          <%= hidden_field_tag "dates[]", d.iso8601 %>
        <% end %>
        <%= hidden_field_tag :force_mode, "skip_conflicts" %>
        <%= button_tag "勤務指定を優先する", class: "btn btn-sm btn-outline-secondary" %>
      <% end %>

      <%= link_to "キャンセル",
                  settings_shift_month_path(@shift_month, tab: "holiday", staff_id: @selected_staff.id),
                  class: "btn btn-sm btn-light border" %>
    </div>
  </div>
<% end %>

<%= form_with model: @shift_month,
              url: update_settings_shift_month_path(@shift_month),
              method: :patch,
              local: true do |f| %>
  <div class="mb-3">
    <p class="fw-bold small">今月の休日日数</p>
    <label class="form-label small">全職員共通</label>
    <div class="d-flex justify align-items-center">
      <%= f.number_field :holiday_days,
                         min: 0,
                         max: 31,
                         class: "form-control form-control-sm w-auto me-1" %>
      <span class="small">日</span>
      <div class="ms-3">
        <%= f.submit "登録", class: "btn btn-sm btn-light border" %>
      </div>
    </div>
  </div>
<% end %>

<hr class="my-3">

<div class="mb-2">
  <p class="fw-bold small mb-2">職員の休日希望</p>

  <%= form_with url: settings_shift_month_path(@shift_month),
                method: :get,
                local: true do %>
    <%= hidden_field_tag :tab, "holiday" %>

    <div class="flex-grow-1">
      <%= select_tag :staff_id,
          options_for_select(
            @all_staffs.select(&:active?).map { |staff| ["#{staff.last_name} #{staff.first_name}", staff.id] },
            @selected_staff&.id
          ),
          include_blank: "職員を選択",
          class: "form-select form-select-sm",
          onchange: "this.form.requestSubmit()" %>
    </div>
  <% end %>

  <% if @selected_staff %>
    <%= form_with url: bulk_add_staff_holidays_shift_month_path(@shift_month),
                  method: :post,
                  local: true,
                  data: { controller: "holiday-multi-select" } do %>
      <%= hidden_field_tag :staff_id, @selected_staff.id %>

      <div class="mt-3">
        <label class="form-label small">休日設定</label>

        <div class="d-flex gap-2 align-items-end">
          <div style="min-width: 120px;">
            <%= select_tag :holiday_type,
                  options_for_select([
                    ["休み", "admin_off"],
                    ["希望休", "requested_off"],
                    ["有休", "paid_leave"]
                  ], @selected_holiday_type),
                  class: "form-select form-select-sm" %>
          </div>
        </div>

        <div class="mt-2 holiday-picker-wrap">
          <%= text_field_tag :holiday_picker,
                "",
                class: "d-none",
                data: {
                  holiday_multi_select_target: "input",
                  min_date: @month_begin.iso8601,
                  max_date: @month_end.iso8601
                },
                autocomplete: "off" %>
        </div>

        <div class="small mt-2">
          選択中:
          <span data-holiday-multi-select-target="summary">
            <% if @selected_holiday_dates.present? %>
              <%= @selected_holiday_dates.sort.map { |d| d.strftime("%-m/%-d") }.join("、") %>
            <% else %>
              未選択
            <% end %>
          </span>
        </div>

        <% @selected_holiday_dates.each do |date| %>
          <input
            type="hidden"
            name="dates[]"
            value="<%= date.iso8601 %>"
            data-holiday-multi-select-target="hiddenDates">
        <% end %>

        <div class="d-flex justify-content-end mt-2">
          <%= submit_tag "まとめて追加", class: "btn btn-sm btn-light border" %>
        </div>
      </div>
    <% end %>

    <div class="mt-3">
      <div class="small text-muted mb-1">指定済み</div>

      <% if @selected_staff_holidays.any? %>
        <ul class="list-unstyled small">
          <% @selected_staff_holidays.each do |request| %>
            <li class="d-flex justify-content-between align-items-center mb-1">
              <span>
                <%= request.date.strftime("%-m/%-d") %>
                <% label =
                    case request.holiday_type
                    when "admin_off"
                      "休み"
                    when "requested_off"
                      "希望休"
                    when "paid_leave"
                      "有休"
                    else
                      "休み"
                    end %>
                <span class="ms-1 text-muted">(<%= label %>)</span>
              </span>

              <%= button_to "削除",
                            remove_staff_holiday_shift_month_path(@shift_month, request_id: request.id),
                            method: :delete,
                            class: "btn btn-sm btn-outline-danger py-0 px-2",
                            form_class: "m-0" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="small text-muted">まだ指定がありません</div>
      <% end %>
    </div>
  <% end %>
</div>