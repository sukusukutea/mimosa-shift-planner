<% if client.errors.any? %>
  <div class="alert alert-danger">
    <div class="fw-bold mb-2">入力内容を確認してください。</div>
    <ul class="mb-0">
      <% client.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% wdays = [["月", 0], ["火", 1], ["水", 2], ["木", 3], ["金", 4], ["土", 5], ["日", 6]] %>
<% day_service_wdays = Array(@day_service_wdays).map(&:to_i) %>
<% visit_wdays = Array(@visit_wdays).map(&:to_i) %>

<%= form_with model: client, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :display_name, "表示名", class: "form-label" %>
    <%= f.text_field :display_name, class: "form-control", required: true, autocomplete: "off" %>
    <div class="form-text">
      シフト表に表示する名前です。実名フルネームではなく、苗字・略称・識別名で登録できます。
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :sort_key, "ふりがな", class: "form-label" %>
    <%= f.text_field :sort_key,
                 class: "form-control",
                 required: true,
                 autocomplete: "off",
                 pattern: "[ぁ-んー]+",
                 title: "ひらがなで入力してください" %>
  </div>

  <div class="mb-4">
    <div class="fw-bold mb-2">基本利用曜日</div>

    <div class="border rounded p-3 mb-3">
      <div class="fw-semibold mb-2">通い</div>

      <div class="d-flex flex-wrap gap-3">
        <% wdays.each do |label, value| %>
          <label class="form-check form-check-inline mb-0">
            <%= check_box_tag "client_regular_schedules[day_service_wdays][]",
                              value,
                              day_service_wdays.include?(value),
                              class: "form-check-input" %>
            <span class="form-check-label"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="border rounded p-3">
      <div class="fw-semibold mb-2">訪問</div>

      <div class="d-flex flex-wrap gap-3">
        <% wdays.each do |label, value| %>
          <label class="form-check form-check-inline mb-0">
            <%= check_box_tag "client_regular_schedules[visit_wdays][]",
                              value,
                              visit_wdays.include?(value),
                              class: "form-check-input" %>
            <span class="form-check-label"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="form-text mt-2">
      同じ曜日に「通い」と「訪問」の両方を登録できます。
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "戻る", clients_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
